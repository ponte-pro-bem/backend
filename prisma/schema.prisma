// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  name      String   @unique
  hash      String
  salt      String
  isAdmin   Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Tag {
  id            String       @id @default(uuid())
  name          String
  createdAt     DateTime     @default(now())
  institution   Institution? @relation(fields: [institutionId], references: [id])
  institutionId String?
  campaign      Campaign?    @relation(fields: [campaignId], references: [id])
  campaignId    String?
  iconLibrary   String?
  icon          String?
}

model Donation {
  id            String       @id @default(uuid())
  name          String
  value         String
  cpf           String
  createdAt     DateTime     @default(now())
  institution   Institution? @relation(fields: [institutionId], references: [id])
  institutionId String?
  campaign      Campaign?    @relation(fields: [campaignId], references: [id])
  campaignId    String?
}

model Institution {
  id           String     @id @default(uuid())
  name         String
  images       Image[]
  description  String
  campaigns    Campaign[]
  pixQRCodeRaw String
  createdAt    DateTime   @default(now())
  tags         Tag[]
  donation     Donation[]
}

model Campaign {
  id            String      @id @default(uuid())
  name          String
  images        Image[]
  description   String
  pixQRCodeRaw  String
  startDate     String
  endDate       String
  institution   Institution @relation(fields: [institutionId], references: [id])
  institutionId String
  createdAt     DateTime    @default(now())
  tags          Tag[]
  donation      Donation[]
}

model Image {
  id            String       @id @default(uuid())
  key           String
  url           String
  institution   Institution? @relation(fields: [institutionId], references: [id])
  institutionId String?
  campaign      Campaign?    @relation(fields: [campaignId], references: [id])
  campaignId    String?
}
